// ============================================================================
// FONCTION PRINCIPALE
// ============================================================================

async function main() {
  console.log('🚀 Démarrage du Code Mapper...');

  const startTime = Date.now();
  const rootDir = process.cwd();

  // Configuration des options (à implémenter dans T013)
  const options = {
    outputJson: true,
    outputMindMap: true,
    outputSqlite: true,
    outputDir: path.join(rootDir, 'audit')
  };

  try {
    // 1. Créer le dossier de sortie
    if (!fs.existsSync(options.outputDir)) {
      fs.mkdirSync(options.outputDir, { recursive: true });
    }

    // 2. Initialiser le projet TypeScript
    const project = new Project({
      tsConfigFilePath: path.join(rootDir, 'tsconfig.json'),
      skipAddingFilesFromTsConfig: true
    });

    // 3. Scanner les fichiers (T002)
    const files = await scanFiles(rootDir);

    // 4. Analyser les fichiers TypeScript (T003-T006)
    await analyzeTypeScriptFiles(files, project);

    // 5. Construire les relations (T007-T008)
    const relations = await buildRelations(files);

    // 6. Calculer les métriques (T009)
    await calculateMetrics(files);

    // 7. Générer les exports
    if (options.outputJson) {
      const jsonPath = path.join(options.outputDir, 'code_map.json');
      await generateJsonCodeMap(files, relations, jsonPath);
    }

    if (options.outputMindMap) {
      const mmPath = path.join(options.outputDir, 'code_map.mm');
      await generateFreeMindMap(files, relations, mmPath);
    }

    if (options.outputSqlite) {
      const dbPath = path.join(options.outputDir, 'code_map.db');
      await generateSqliteDatabase(files, relations, dbPath);
    }

    const elapsedTime = Date.now() - startTime;

    console.log('\n✅ Code Mapper terminé avec succès !');
    console.log(`⏱️  Temps d'exécution: ${elapsedTime}ms`);

  } catch (error: any) {
    console.error('❌ Erreur lors de l\'exécution:', error.message);
    process.exit(1);
  }
}

// ============================================================================
// POINT D'ENTRÉE
// ============================================================================

if (import.meta.url === `file://${process.argv[1]}`) {
  main().catch((error: any) => {
    console.error('❌ Erreur fatale:', error);
    process.exit(1);
  });
}

