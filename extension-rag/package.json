{
  "name": "rag-mcp-extension",
  "displayName": "RAG MCP Extension (Read-Only)",
  "description": "VS Code extension for monitoring RAG MCP Server - Read-only interface that reads monitoring files",
  "version": "0.2.0",
  "publisher": "rag-mcp",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rag-mcp.showDashboard",
        "title": "RAG MCP: Show Dashboard"
      },
      {
        "command": "rag-mcp.getStatus",
        "title": "RAG MCP: Get System Status"
      },
      {
        "command": "rag-mcp.showMetrics",
        "title": "RAG MCP: Show Metrics"
      },
      {
        "command": "rag-mcp.showHealth",
        "title": "RAG MCP: Show Health Status"
      },
      {
        "command": "rag-mcp.showEvents",
        "title": "RAG MCP: Show Recent Events"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rag-mcp-activitybar",
          "title": "RAG MCP",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "rag-mcp-activitybar": [
        {
          "id": "rag-mcp.dashboard",
          "name": "Dashboard",
          "type": "webview"
        },
        {
          "id": "rag-mcp.metrics",
          "name": "Metrics",
          "type": "webview"
        },
        {
          "id": "rag-mcp.health",
          "name": "Health",
          "type": "webview"
        },
        {
          "id": "rag-mcp.events",
          "name": "Events",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "RAG MCP Extension",
      "properties": {
        "rag-mcp.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-refresh of dashboard"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "jest --config jest.config.js",
    "test:unit:watch": "jest --config jest.config.js --watch",
    "test:unit:coverage": "jest --config jest.config.js --coverage",
    "test:unit:verbose": "jest --config jest.config.js --verbose",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
