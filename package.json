{
  "name": "rag-mcp-server",
  "version": "1.0.0",
  "description": "Serveur MCP unifié combinant graphe de connaissances et RAG pour la mémoire cognitive",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "rag-mcp-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run test:build && npm run test:run",
    "test:build": "tsc --project tsconfig.test.json",
    "test:run": "node --test build-test/**/*.js",
    "test:dev": "node --test --watch test/phase0-chunker/test-chunker-intelligent.ts",
    "test:chunker": "npm run test:build && node --test build-test/test/phase0-chunker/test-chunker-intelligent.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@xenova/transformers": "^2.17.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "pg": "^8.16.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.16.0",
    "@vitest/ui": "^4.0.17",
    "chokidar": "^5.0.0",
    "eslint-plugin-import": "^2.32.0",
    "lodash.debounce": "^4.0.8",
    "madge": "^8.0.0",
    "shx": "^0.3.4",
    "ts-morph": "^27.0.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "files": [
    "build/**/*",
    "templates/**/*"
  ],
  "keywords": [
    "mcp",
    "memory",
    "rag",
    "knowledge-graph",
    "cognitive",
    "vector-search",
    "semantic-search"
  ],
  "author": "RAG MCP Server Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/rag-mcp-server"
  },
  "bugs": {
    "url": "https://github.com/your-org/rag-mcp-server/issues"
  },
  "homepage": "https://github.com/your-org/rag-mcp-server#readme"
}
