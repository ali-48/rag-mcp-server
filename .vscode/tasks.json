{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "detail": "Build TypeScript project"
    },
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "group": "none",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Start RAG MCP Server"
    },
    {
      "label": "npm: dev",
      "type": "npm",
      "script": "dev",
      "group": "none",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "detail": "TypeScript watch mode"
    },
    {
      "label": "npm: test",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run all tests"
    },
    {
      "label": "npm: test:dev",
      "type": "npm",
      "script": "test:dev",
      "group": "none",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Run tests in watch mode"
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "rm -rf build build-test",
      "group": "clean",
      "problemMatcher": [],
      "detail": "Clean build directories"
    },
    {
      "label": "TypeScript Check",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "detail": "TypeScript type checking without emit"
    },
    {
      "label": "ESLint Fix",
      "type": "shell",
      "command": "npx eslint . --fix",
      "group": "build",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Run ESLint auto-fix"
    },
    {
      "label": "Prettier Format",
      "type": "shell",
      "command": "npx prettier --write .",
      "group": "build",
      "problemMatcher": [],
      "detail": "Format all files with Prettier"
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "group": "build",
      "problemMatcher": [],
      "detail": "Install npm dependencies"
    },
    {
      "label": "Update Dependencies",
      "type": "shell",
      "command": "npm update",
      "group": "build",
      "problemMatcher": [],
      "detail": "Update npm dependencies"
    },
    {
      "label": "Run RAG Pipeline",
      "type": "shell",
      "command": "node build/index.js --mode=full",
      "group": "none",
      "problemMatcher": [],
      "detail": "Run full RAG pipeline"
    },
    {
      "label": "Database Migration",
      "type": "shell",
      "command": "node scripts/migrate-rag-store.js",
      "group": "none",
      "problemMatcher": [],
      "detail": "Run RAG database migration"
    },
    {
      "label": "Generate Documentation",
      "type": "shell",
      "command": "npx typedoc --out docs/api src/index.ts",
      "group": "build",
      "problemMatcher": [],
      "detail": "Generate TypeScript documentation"
    },
    {
      "label": "Security Audit",
      "type": "shell",
      "command": "npm audit",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run npm security audit"
    },
    {
      "label": "Check Dependencies",
      "type": "shell",
      "command": "npx depcheck",
      "group": "test",
      "problemMatcher": [],
      "detail": "Check for unused dependencies"
    },
    {
      "label": "RAG: Ingest Documents",
      "type": "shell",
      "command": "node build/index.js --mode=ingest --path=./docs",
      "group": "none",
      "problemMatcher": [],
      "detail": "Ingest documents into RAG pipeline"
    },
    {
      "label": "RAG: Index Vectors",
      "type": "shell",
      "command": "node build/index.js --mode=index",
      "group": "none",
      "problemMatcher": [],
      "detail": "Create vector embeddings for ingested documents"
    },
    {
      "label": "RAG: Query",
      "type": "shell",
      "command": "node build/index.js --mode=query --query=\"How to use RAG MCP?\"",
      "group": "none",
      "problemMatcher": [],
      "detail": "Query RAG pipeline with semantic search"
    },
    {
      "label": "RAG: Clean Cache",
      "type": "shell",
      "command": "rm -rf rag/cache rag/temp",
      "group": "clean",
      "problemMatcher": [],
      "detail": "Clean RAG pipeline cache and temporary files"
    },
    {
      "label": "RAG: Initialize Databases",
      "type": "shell",
      "command": "./.vscode/init-databases.sh",
      "group": "build",
      "problemMatcher": [],
      "detail": "Initialize SQLite and PostgreSQL databases for RAG"
    },
    {
      "label": "RAG: Install Extensions",
      "type": "shell",
      "command": "./.vscode/install-extensions.sh",
      "group": "build",
      "problemMatcher": [],
      "detail": "Install recommended VS Code extensions for RAG development"
    },
    {
      "label": "RAG: Monitor Logs",
      "type": "shell",
      "command": "tail -f logs/rag-server.log",
      "group": "none",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Monitor RAG MCP Server logs in real-time"
    },
    {
      "label": "RAG: Test Pipeline",
      "type": "shell",
      "command": "npm run test:rag",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run RAG pipeline integration tests"
    },
    {
      "label": "RAG: Export Config",
      "type": "shell",
      "command": "node scripts/export-config.js",
      "group": "build",
      "problemMatcher": [],
      "detail": "Export RAG configuration for deployment"
    }
  ]
}
