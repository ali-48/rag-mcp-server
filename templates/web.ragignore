# ============================================

# Dossiers de dépendances Node.js
node_modules/
.npm/
.yarn/
.pnpm/
.bower_components/
.jspm_packages/

# Cache des packages
.cache/
.npm-cache/
.yarn-cache/
.bower-cache/

# ============================================
# Fichiers de build et distribution
# ============================================

# Dossiers de build
dist/
build/
out/
coverage/
.nyc_output/
public/
static/

# Fichiers de production
*.min.js
*.min.css
*.min.js.map
*.min.css.map
*.bundle.js
*.bundle.css

# Assets optimisés
assets/optimized/
images/optimized/

