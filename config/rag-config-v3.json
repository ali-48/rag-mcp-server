{
    "version": "3.0.0",
    "description": "Configuration RAG v3.0 - Nouveau pipeline avec file d'attente, checkpoints, UI humaine, et désactivation activated_rag",
    "last_updated": "14/01/2026",
    "system": {
        "mode": "memory-only",
        "exposed_tools": [
            "init_rag",
            "scan_rag",
            "index_rag",
            "query_rag",
            "manage_projects",
            "pipeline_validator"
        ],
        "legacy_tools": [
            "activated_rag",
            "injection_rag",
            "index_project",
            "update_project",
            "search_code",
            "recherche_rag"
        ],
        "legacy_mode": false,
        "auto_detect_vscode": true,
        "auto_watch_files": false,
        "auto_index_changes": false,
        "vector_store": {
            "backend": "sqlite",
            "path": "./rag/db/vector/rag_vectors.sqlite"
        }
    },
    "ui": {
        "human_progress": {
            "enabled": true,
            "type": "bar",
            "width": 40,
            "realtime": true,
            "update_interval": 100,
            "show_eta": true,
            "show_stats": true,
            "show_phases": true,
            "show_memory": false,
            "show_cpu": false,
            "colors": {
                "bar": "\u001b[32m",
                "percentage": "\u001b[36m",
                "eta": "\u001b[33m",
                "stats": "\u001b[35m",
                "phase": "\u001b[34m",
                "memory": "\u001b[31m",
                "cpu": "\u001b[31m"
            },
            "output_format": "text",
            "output_target": "stdout"
        },
        "verbose_logging": false,
        "format_output": true,
        "interactive_mode": false
    },
    "legacy": {
        "activated_rag": {
            "enabled": false,
            "redirect_to_pipeline": true,
            "error_message": "activated_rag est désactivé. Utilisez le pipeline RAG explicite: init_rag → scan_rag → index_rag → query_rag",
            "migration_guide": "docs/MIGRATION_V2_V3.md"
        },
        "compatibility_mode": false,
        "preserve_old_data": true,
        "migration_script": "scripts/migrate-v1-to-v2.js"
    },
    "checkpoints": {
        "enabled": true,
        "auto_save": true,
        "save_interval": 30000,
        "max_checkpoints": 10,
        "retention_days": 7,
        "compression": true,
        "encryption": false,
        "locations": {
            "memory": "./rag/db/checkpoints/memory",
            "vector": "./rag/db/checkpoints/vector",
            "metadata": "./rag/db/checkpoints/metadata"
        },
        "recovery": {
            "auto_recover": true,
            "max_attempts": 3,
            "validation_strictness": "medium"
        }
    },
    "queue": {
        "max_size_per_project": 3,
        "fifo_order": true,
        "mutator_exclusivity": true,
        "readonly_concurrent": 5,
        "timeout": null,
        "retry": {
            "enabled": true,
            "max_attempts": 3,
            "backoff_factor": 2,
            "initial_delay": 1000
        },
        "stats": {
            "enabled": true,
            "retention_days": 30,
            "aggregation_interval": 3600000
        }
    },
    "defaults": {
        "embedding_provider": "fake",
        "embedding_model": "qwen3-embedding:8b",
        "chunk_size": 500,
        "chunk_overlap": 100,
        "file_patterns": [
            "**/*.{js,ts,py,md,txt,json,yaml,yml,html,css,scss}"
        ],
        "recursive": true,
        "search_limit": 20,
        "search_threshold": 0.3,
        "format_output": true
    },
    "embedding_models": {
        "by_content_type": {
            "code": {
                "provider": "ollama",
                "model": "nomic-embed-code",
                "dimension": 768,
                "description": "Modèle optimisé pour le code source"
            },
            "text": {
                "provider": "ollama",
                "model": "nomic-embed-text",
                "dimension": 768,
                "description": "Modèle optimisé pour la documentation et texte"
            },
            "config": {
                "provider": "ollama",
                "model": "bge-small",
                "dimension": 384,
                "description": "Modèle léger pour fichiers de configuration"
            },
            "fallback": {
                "provider": "ollama",
                "model": "qwen3-embedding:8b",
                "dimension": 1024,
                "description": "Modèle de fallback généraliste"
            }
        },
        "providers": {
            "fake": {
                "description": "Fournisseur factice pour les tests",
                "models": [
                    "nomic-embed-text",
                    "all-minilm",
                    "qwen3-embedding:8b"
                ],
                "requires_ollama": false
            },
            "ollama": {
                "description": "Fournisseur Ollama pour embeddings locaux",
                "models": [
                    "nomic-embed-text",
                    "nomic-embed-code",
                    "all-minilm",
                    "mxbai-embed-large",
                    "bge-m3",
                    "bge-small",
                    "qwen3-embedding:8b",
                    "qwen3-embedding:latest"
                ],
                "endpoint": "http://localhost:11434",
                "requires_ollama": true,
                "default_model": "qwen3-embedding:8b"
            },
            "sentence-transformers": {
                "description": "Fournisseur Sentence Transformers",
                "models": [
                    "all-MiniLM-L6-v2",
                    "paraphrase-multilingual-MiniLM-L12-v2",
                    "all-mpnet-base-v2"
                ],
                "requires_ollama": false,
                "default_model": "all-MiniLM-L6-v2"
            }
        }
    },
    "phase0": {
        "enabled": true,
        "description": "Phase 0 - Détection automatique et pipeline complet",
        "components": {
            "workspace_detector": {
                "enabled": true,
                "detect_vscode": true,
                "detect_git": true,
                "auto_select_project": true
            },
            "file_watcher": {
                "enabled": false,
                "library": "chokidar",
                "watch_options": {
                    "ignored": [
                        "node_modules",
                        ".git",
                        "*.log"
                    ],
                    "persistent": true,
                    "ignoreInitial": true,
                    "interval": 1000,
                    "binaryInterval": 3000
                },
                "debounce_ms": 1000,
                "max_file_size_mb": 10
            },
            "tree_sitter": {
                "enabled": true,
                "languages": [
                    "javascript",
                    "typescript",
                    "python",
                    "json",
                    "yaml",
                    "markdown"
                ],
                "max_file_size_mb": 10,
                "timeout_ms": 5000,
                "fallback_to_regex": true
            },
            "chunking": {
                "strategy": "logical",
                "max_chunk_size": 1000,
                "chunk_overlap": 200,
                "rules": {
                    "function_as_chunk": true,
                    "class_as_chunk": true,
                    "max_function_lines": 200,
                    "max_class_methods": 10,
                    "preserve_imports": true,
                    "include_comments": true,
                    "doc_by_paragraph": true,
                    "config_by_object": true
                }
            },
            "llm_enrichment": {
                "enabled": true,
                "provider": "fake",
                "model": "test-model",
                "temperature": 0.1,
                "max_tokens": 500,
                "timeout_ms": 10000,
                "batch_size": 5,
                "features": [
                    "summary",
                    "keywords"
                ],
                "cache_enabled": false,
                "cache_ttl_seconds": 3600
            }
        },
        "pipeline": {
            "auto_start": true,
            "concurrent_workers": 2,
            "max_queue_size": 100,
            "retry_attempts": 3,
            "retry_delay_ms": 1000
        }
    },
    "pipeline": {
        "description": "Nouveau pipeline RAG avec file d'attente et checkpoints",
        "phases": [
            {
                "name": "init",
                "tool": "init_rag",
                "description": "Initialisation du projet RAG",
                "required": true,
                "depends_on": []
            },
            {
                "name": "scan",
                "tool": "scan_rag",
                "description": "Scan des fichiers et analyse structurelle",
                "required": true,
                "depends_on": [
                    "init"
                ]
            },
            {
                "name": "prepare",
                "tool": "index_rag",
                "description": "Préparation et chunking des fichiers",
                "required": true,
                "depends_on": [
                    "scan"
                ]
            },
            {
                "name": "embed",
                "tool": "index_rag",
                "description": "Génération des embeddings",
                "required": true,
                "depends_on": [
                    "prepare"
                ]
            },
            {
                "name": "index",
                "tool": "index_rag",
                "description": "Indexation dans la base vectorielle",
                "required": true,
                "depends_on": [
                    "embed"
                ]
            },
            {
                "name": "query",
                "tool": "query_rag",
                "description": "Recherche sémantique",
                "required": false,
                "depends_on": [
                    "index"
                ]
            }
        ],
        "validation": {
            "enabled": true,
            "strict": false,
            "schema_path": "config/pipeline-schema.json"
        },
        "orchestration": {
            "auto_progress": true,
            "parallel_phases": false,
            "error_handling": "continue",
            "timeout": null
        }
    },
    "limits": {
        "chunk_size": {
            "min": 100,
            "max": 10000,
            "default": 500
        },
        "chunk_overlap": {
            "min": 0,
            "max": 1000,
            "default": 100
        },
        "search_limit": {
            "min": 1,
            "max": 50,
            "default": 20
        },
        "search_threshold": {
            "min": 0,
            "max": 1,
            "default": 0.3
        },
        "file_size": {
            "max_mb": 50,
            "warning_mb": 10
        },
        "concurrent": {
            "max_files": 10,
            "max_chunks": 1000,
            "max_embeddings": 100
        },
        "preparation_batch_size": {
            "min": 1,
            "max": 20,
            "default": 5
        },
        "preparation_timeout": {
            "min": 1000,
            "max": 60000,
            "default": 30000
        }
    },
    "file_handling": {
        "default_patterns": [
            "**/*.js",
            "**/*.ts",
            "**/*.py",
            "**/*.md",
            "**/*.txt",
            "**/*.json",
            "**/*.yaml",
            "**/*.yml",
            "**/*.html",
            "**/*.css",
            "**/*.scss"
        ],
        "ignore_patterns": [
            "node_modules/",
            "venv/",
            "__pycache__/",
            "*.log",
            "*.png",
            "*.jpg",
            "*.jpeg",
            "*.gif",
            "dist/",
            "build/",
            ".git/"
        ],
        "recursive_default": true,
        "follow_symlinks": false
    },
    "indexing": {
        "max_file_size_mb": 10,
        "supported_extensions": [
            ".js",
            ".ts",
            ".py",
            ".md",
            ".txt",
            ".json",
            ".yaml",
            ".yml",
            ".html",
            ".css",
            ".scss"
        ],
        "content_type_mapping": {
            "code": [
                ".js",
                ".ts",
                ".py",
                ".java",
                ".cpp",
                ".go",
                ".rs"
            ],
            "doc": [
                ".md",
                ".txt"
            ],
            "config": [
                ".json",
                ".yaml",
                ".yml"
            ],
            "web": [
                ".html",
                ".css",
                ".scss"
            ]
        },
        "text_extensions": [
            ".md",
            ".txt",
            ".json",
            ".yaml",
            ".yml"
        ],
        "code_extensions": [
            ".js",
            ".ts",
            ".py",
            ".html",
            ".css",
            ".scss"
        ]
    },
    "search": {
        "default_limit": 20,
        "max_limit": 50,
        "similarity_threshold": 0.3,
        "dynamic_threshold": false,
        "format_results": true,
        "include_context_lines": 3,
        "hybrid_search": {
            "enabled": true,
            "semantic_weight": 0.7,
            "text_weight": 0.3
        }
    },
    "environments": {
        "development": {
            "embedding_provider": "fake",
            "embedding_model": "qwen3-embedding:8b",
            "verbose_logging": true,
            "cache_enabled": true,
            "batch_size": 10,
            "ui_human_progress": true
        },
        "production": {
            "embedding_provider": "ollama",
            "embedding_model": "qwen3-embedding:8b",
            "verbose_logging": false,
            "cache_enabled": true,
            "batch_size": 50,
            "ui_human_progress": false
        }
    },
    "error_handling": {
        "mcp_formatting": true,
        "human_formatting": true,
        "structured_logging": true,
        "error_recovery": false,
        "statistics": true,
        "alert_thresholds": {
            "error_rate": 0.1,
            "consecutive_errors": 5,
            "memory_usage": 90
        }
    },
    "cache": {
        "enabled": true,
        "ttl_seconds": 3600
    },
    "migration": {
        "from_version": "2.0.0",
        "auto_migrate": true,
        "backup_old_config": true,
        "preserve_legacy_tools": false,
        "migration_script": "scripts/migrate-v2-to-v3.js",
        "breaking_changes": [
            "activated_rag désactivé par défaut",
            "Nouveau pipeline avec file d'attente",
            "Système de checkpoints",
            "UI humaine optionnelle"
        ]
    }
}